# Copy to android/key.properties (git-ignored) and fill in real values.
# Generate a keystore with:
#   keytool -genkey -v -keystore ~/aurenix-upload.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
storePassword=
keyPassword=
keyAlias=upload
storeFile=/absolute/path/to/aurenix-upload.jks
